{
  "expo": {
    "name": "SpotWave",
    "slug": "SpotWave",
    "scheme": "spotwave",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0F1A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.matteogalfre.SpotWave",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "SpotWave utilise votre position pour afficher les spots de surf les plus proches."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0F1A"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.matteogalfre.SpotWave",
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SpotWave utilise votre position pour afficher les spots de surf les plus proches."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "6502e0d2-178b-42ce-835e-fb60f71ef237"
      }
    }
  }
}
