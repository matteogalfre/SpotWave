{
  "expo": {
    "name": "SpotWave",
    "slug": "SpotWave",
    "scheme": "spotwave",
    "version": "1.0.9",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.spotwave.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "SpotWave utilise votre position pour afficher les spots de surf les plus proches."
      }
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FBF2DF"
      },
      "package": "com.spotwave.app",
      "versionCode": 33,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withDeviceCompatibility.js",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SpotWave utilise votre position pour afficher les spots de surf les plus proches."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FBF2DF"
        }
      ]
    ],
    "owner": "scrtymailer",
    "extra": {
      "eas": {
        "projectId": "068cc588-5389-4af2-a6b8-cf47df297fc3"
      }
    }
  }
}
