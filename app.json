{
  "expo": {
    "name": "SpotWave",
    "slug": "SpotWave",
    "scheme": "spotwave",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.spotwave.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "SpotWave utilise votre position pour afficher les spots de surf les plus proches."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0F1A"
      },
      "package": "com.spotwave.app",
      "versionCode": 14,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SpotWave utilise votre position pour afficher les spots de surf les plus proches."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0B0F1A"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d47380e8-6d28-46fd-9ad6-e372fa7f92cd"
      }
    },
    "owner": "mcleanjeanluc"
  }
}
